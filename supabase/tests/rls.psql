-- Run only against a test database after provisioning two organizations and assignments.
-- psql -v assessor_a=... -v admin_a=... -v participant_a=... -v participant_b=... -f supabase/tests/rls.psql "$DATABASE_URL"
\set ON_ERROR_STOP on
begin;
set local role authenticated;
select set_config('request.jwt.claim.sub', :'assessor_a', true);
select 1 / case when exists(select 1 from public.participants where id=:'participant_a'::uuid)
 and not exists(select 1 from public.participants where id=:'participant_b'::uuid)
 then 1 else 0 end as assessor_isolation;
select 1 / case when not has_table_privilege('authenticated','public.assessment_responses','INSERT')
 and not has_table_privilege('authenticated','public.assessment_sessions','INSERT')
 then 1 else 0 end as sensitive_writes_use_rpc;
select set_config('request.jwt.claim.sub', :'admin_a', true);
select 1 / case when exists(select 1 from public.participants where id=:'participant_a'::uuid)
 and not exists(select 1 from public.participants where id=:'participant_b'::uuid)
 then 1 else 0 end as admin_organization_isolation;
select 1 / case when not has_table_privilege('anon','public.public_quiz_attempts','SELECT')
 and not has_table_privilege('anon','public.public_quiz_questions','SELECT')
 and not has_function_privilege('anon','public.submit_public_quiz(text,uuid,text,integer,jsonb,text)','EXECUTE')
 then 1 else 0 end as public_quiz_private_rows;
rollback;
